<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>SkyCast - Weather Application</title>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial, Helvetica, sans-serif;
}

:root{
    --bg:#eef6ff;
    --card:rgba(255,255,255,0.78);
    --text:#172033;
    --muted:#667085;
    --primary:#2674ff;
    --secondary:#6c5ce7;
    --border:rgba(255,255,255,0.6);
    --shadow:0 15px 40px rgba(30,70,120,0.12);
}

body.dark{
    --bg:#0e1726;
    --card:rgba(25,37,57,0.88);
    --text:#f3f6fb;
    --muted:#a9b4c7;
    --border:rgba(255,255,255,0.08);
    --shadow:0 15px 40px rgba(0,0,0,0.3);
}

body{
    min-height:100vh;
    background:
        radial-gradient(circle at 10% 10%,#c9e7ff,transparent 30%),
        radial-gradient(circle at 90% 20%,#ddd4ff,transparent 30%),
        var(--bg);
    color:var(--text);
    transition:0.3s;
}

/* HEADER */

header{
    width:100%;
    padding:18px 7%;
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:20px;
}

.logo{
    font-size:25px;
    font-weight:800;
    white-space:nowrap;
}

.logo span{
    color:var(--primary);
}

.header-buttons{
    display:flex;
    gap:10px;
}

.icon-btn{
    border:none;
    width:42px;
    height:42px;
    border-radius:50%;
    cursor:pointer;
    background:var(--card);
    color:var(--text);
    box-shadow:var(--shadow);
    font-size:18px;
    transition:0.2s;
}

.icon-btn:hover{
    transform:translateY(-2px);
}

/* MAIN */

.container{
    width:86%;
    max-width:1200px;
    margin:auto;
    padding-bottom:50px;
}

/* SEARCH */

.search-area{
    display:flex;
    justify-content:center;
    margin:15px 0 28px;
}

.search-box{
    width:100%;
    max-width:650px;
    display:flex;
    background:var(--card);
    border:1px solid var(--border);
    border-radius:18px;
    padding:7px;
    box-shadow:var(--shadow);
}

.search-box input{
    flex:1;
    border:none;
    outline:none;
    background:transparent;
    padding:14px;
    color:var(--text);
    font-size:16px;
}

.search-box button{
    border:none;
    background:var(--primary);
    color:white;
    padding:0 22px;
    border-radius:13px;
    cursor:pointer;
    font-weight:bold;
}

.search-box button:hover{
    opacity:0.9;
}

/* LOCATION */

.location-bar{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-bottom:20px;
    gap:15px;
}

.location-info h2{
    font-size:27px;
}

.location-info p{
    color:var(--muted);
    margin-top:5px;
}

.location-actions{
    display:flex;
    gap:8px;
    flex-wrap:wrap;
}

.small-btn{
    border:none;
    background:var(--card);
    color:var(--text);
    padding:10px 14px;
    border-radius:12px;
    cursor:pointer;
    box-shadow:var(--shadow);
}

.small-btn:hover{
    transform:translateY(-1px);
}

/* CURRENT WEATHER */

.current{
    display:grid;
    grid-template-columns:1.4fr 1fr;
    gap:20px;
}

.card{
    background:var(--card);
    border:1px solid var(--border);
    border-radius:25px;
    box-shadow:var(--shadow);
    backdrop-filter:blur(12px);
}

.main-weather{
    padding:30px;
    min-height:300px;
    display:flex;
    justify-content:space-between;
    align-items:center;
}

.weather-icon{
    font-size:90px;
}

.temperature{
    font-size:72px;
    font-weight:800;
    line-height:1;
}

.condition{
    font-size:20px;
    margin-top:12px;
    font-weight:600;
}

.feels{
    color:var(--muted);
    margin-top:8px;
}

.unit-toggle{
    margin-top:22px;
    display:flex;
    gap:5px;
}

.unit-toggle button{
    border:none;
    padding:8px 15px;
    border-radius:10px;
    cursor:pointer;
    background:rgba(128,128,128,0.12);
    color:var(--text);
}

.unit-toggle button.active{
    background:var(--primary);
    color:white;
}

/* DETAILS */

.details{
    padding:25px;
}

.details h3{
    margin-bottom:18px;
}

.detail-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:14px;
}

.detail{
    padding:15px;
    border-radius:16px;
    background:rgba(128,128,128,0.08);
}

.detail span{
    display:block;
    color:var(--muted);
    font-size:13px;
    margin-bottom:6px;
}

.detail strong{
    font-size:17px;
}

/* FORECAST */

.section-title{
    margin:32px 0 15px;
    display:flex;
    justify-content:space-between;
    align-items:center;
}

.forecast{
    display:grid;
    grid-template-columns:repeat(7,1fr);
    gap:12px;
}

.forecast-card{
    padding:18px 10px;
    text-align:center;
    transition:0.2s;
}

.forecast-card:hover{
    transform:translateY(-5px);
}

.forecast-day{
    font-weight:bold;
    font-size:14px;
}

.forecast-icon{
    font-size:40px;
    margin:15px 0;
}

.forecast-temp{
    font-weight:bold;
}

.forecast-rain{
    color:#4285f4;
    font-size:13px;
    margin-top:8px;
}

/* EXTRA */

.extra-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:15px;
}

.extra-card{
    padding:22px;
}

.extra-card span{
    color:var(--muted);
    font-size:13px;
}

.extra-card h3{
    margin-top:10px;
}

/* FAVORITE */

.favorite-box{
    margin-top:30px;
    padding:22px;
}

.favorite-city{
    margin-top:12px;
    display:inline-flex;
    align-items:center;
    gap:10px;
    background:rgba(128,128,128,0.1);
    padding:10px 14px;
    border-radius:12px;
}

/* STATUS */

.status{
    text-align:center;
    padding:12px;
    color:var(--muted);
}

.error{
    color:#e63946;
}

/* LOADING */

.loading{
    display:none;
    text-align:center;
    padding:20px;
}

.spinner{
    width:30px;
    height:30px;
    border:4px solid rgba(100,100,100,0.2);
    border-top-color:var(--primary);
    border-radius:50%;
    animation:spin 0.8s linear infinite;
    margin:auto;
}

@keyframes spin{
    to{transform:rotate(360deg);}
}

/* FOOTER */

footer{
    text-align:center;
    color:var(--muted);
    padding:25px;
    font-size:13px;
}

/* RESPONSIVE */

@media(max-width:900px){

    .current{
        grid-template-columns:1fr;
    }

    .forecast{
        grid-template-columns:repeat(4,1fr);
    }

    .extra-grid{
        grid-template-columns:1fr 1fr;
    }
}

@media(max-width:600px){

    header{
        padding:15px 5%;
    }

    .container{
        width:92%;
    }

    .location-bar{
        flex-direction:column;
        align-items:flex-start;
    }

    .main-weather{
        flex-direction:column;
        align-items:flex-start;
        gap:20px;
    }

    .temperature{
        font-size:58px;
    }

    .forecast{
        grid-template-columns:repeat(2,1fr);
    }

    .extra-grid{
        grid-template-columns:1fr;
    }

    .search-box button{
        padding:0 15px;
    }
}
</style>
</head>

<body>

<header>

    <div class="logo">
        🌤️ Sky<span>Cast</span>
    </div>

    <div class="header-buttons">

        <button class="icon-btn"
                id="favoriteHeader"
                title="Favorite city"
                onclick="saveFavorite()">
            ⭐
        </button>

        <button class="icon-btn"
                id="themeBtn"
                title="Change theme"
                onclick="toggleTheme()">
            🌙
        </button>

        <button class="icon-btn"
                title="Refresh weather"
                onclick="loadWeather()">
            🔄
        </button>

    </div>

</header>


<main class="container">

    <!-- SEARCH -->

    <div class="search-area">

        <div class="search-box">

            <input
                type="text"
                id="cityInput"
                placeholder="Search city e.g. Delhi, Mumbai, London..."
                autocomplete="off"
            >

            <button onclick="searchCity()">
                🔍 Search
            </button>

        </div>

    </div>


    <!-- LOCATION -->

    <div class="location-bar">

        <div class="location-info">

            <h2 id="cityName">New Delhi, India</h2>

            <p id="dateTime">
                Loading date...
            </p>

        </div>

        <div class="location-actions">

            <button class="small-btn"
                    onclick="getMyLocation()">
                📍 My Location
            </button>

            <button class="small-btn"
                    onclick="saveFavorite()">
                ⭐ Save
            </button>

        </div>

    </div>


    <!-- LOADING -->

    <div class="loading" id="loading">

        <div class="spinner"></div>

        <p style="margin-top:10px;">
            Fetching weather...
        </p>

    </div>


    <!-- ERROR -->

    <div class="status error"
         id="errorMessage">
    </div>


    <!-- CURRENT WEATHER -->

    <section class="current">

        <div class="card main-weather">

            <div>

                <div class="weather-icon"
                     id="weatherIcon">
                    ☀️
                </div>

                <div class="temperature">
                    <span id="temperature">--</span>°
                    <span id="temperatureUnit">C</span>
                </div>

                <div class="condition"
                     id="condition">
                    Loading...
                </div>

                <div class="feels">
                    Feels like
                    <strong id="feelsLike">--</strong>°
                </div>

                <div class="unit-toggle">

                    <button id="celsiusBtn"
                            class="active"
                            onclick="changeUnit('C')">
                        °C
                    </button>

                    <button id="fahrenheitBtn"
                            onclick="changeUnit('F')">
                        °F
                    </button>

                </div>

            </div>


            <div style="text-align:center">

                <div style="font-size:14px;color:var(--muted)">
                    Today's Range
                </div>

                <h3 style="margin-top:10px;font-size:25px">
                    <span id="minTemp">--</span>° /
                    <span id="maxTemp">--</span>°
                </h3>

            </div>

        </div>


        <!-- WEATHER DETAILS -->

        <div class="card details">

            <h3>🌡️ Weather Details</h3>

            <div class="detail-grid">

                <div class="detail">
                    <span>💧 Humidity</span>
                    <strong id="humidity">--%</strong>
                </div>

                <div class="detail">
                    <span>💨 Wind Speed</span>
                    <strong id="wind">-- km/h</strong>
                </div>

                <div class="detail">
                    <span>🌧️ Rain Chance</span>
                    <strong id="rain">--%</strong>
                </div>

                <div class="detail">
                    <span>☁️ Cloud Cover</span>
                    <strong id="cloud">--%</strong>
                </div>

                <div class="detail">
                    <span>🌅 Sunrise</span>
                    <strong id="sunrise">--</strong>
                </div>

                <div class="detail">
                    <span>🌇 Sunset</span>
                    <strong id="sunset">--</strong>
                </div>

            </div>

        </div>

    </section>


    <!-- FORECAST -->

    <div class="section-title">

        <h2>📅 7-Day Forecast</h2>

    </div>

    <section class="forecast"
             id="forecast">

        <!-- Forecast generated by JavaScript -->

    </section>


    <!-- EXTRA INFORMATION -->

    <div class="section-title">

        <h2>📊 More Information</h2>

    </div>

    <section class="extra-grid">

        <div class="card extra-card">

            <span>🌡️ Pressure</span>

            <h3 id="pressure">-- hPa</h3>

        </div>

        <div class="card extra-card">

            <span>👁️ Visibility</span>

            <h3 id="visibility">-- km</h3>

        </div>

        <div class="card extra-card">

            <span>🌬️ Wind Direction</span>

            <h3 id="windDirection">--</h3>

        </div>

    </section>


    <!-- FAVORITE -->

    <section class="card favorite-box">

        <h3>⭐ Favorite City</h3>

        <div id="favoriteCity"
             class="favorite-city">

            No favorite city saved

        </div>

    </section>

</main>


<footer>

    SkyCast Weather Application • Built with HTML, CSS & JavaScript

</footer>


<script>

/* ==========================================
   GLOBAL VARIABLES
========================================== */

let currentLat = 28.6139;
let currentLon = 77.2090;

let currentCity = "New Delhi, India";

let unit = localStorage.getItem("weatherUnit") || "C";

let weatherData = null;


/* ==========================================
   WEATHER CODE
========================================== */

function getWeatherInfo(code){

    const weather = {

        0:  ["☀️", "Clear Sky"],
        1:  ["🌤️", "Mainly Clear"],
        2:  ["⛅", "Partly Cloudy"],
        3:  ["☁️", "Overcast"],

        45: ["🌫️", "Fog"],
        48: ["🌫️", "Rime Fog"],

        51: ["🌦️", "Light Drizzle"],
        53: ["🌦️", "Moderate Drizzle"],
        55: ["🌧️", "Heavy Drizzle"],

        61: ["🌦️", "Light Rain"],
        63: ["🌧️", "Moderate Rain"],
        65: ["🌧️", "Heavy Rain"],

        71: ["🌨️", "Light Snow"],
        73: ["🌨️", "Moderate Snow"],
        75: ["❄️", "Heavy Snow"],

        80: ["🌦️", "Rain Showers"],
        81: ["🌧️", "Heavy Showers"],
        82: ["⛈️", "Violent Showers"],

        95: ["⛈️", "Thunderstorm"],
        96: ["⛈️", "Thunderstorm + Hail"],
        99: ["⛈️", "Heavy Thunderstorm"]

    };

    return weather[code] || ["🌤️","Unknown Weather"];
}


/* ==========================================
   SEARCH CITY
========================================== */

async function searchCity(){

    const input =
        document.getElementById("cityInput");

    const city =
        input.value.trim();

    if(!city){

        showError("Please enter a city name.");

        return;
    }

    clearError();

    try{

        showLoading(true);

        const response =
            await fetch(
                `https://geocoding-api.open-meteo.com/v1/search?name=${encodeURIComponent(city)}&count=1&language=en&format=json`
            );

        const data =
            await response.json();

        if(!data.results ||
           data.results.length === 0){

            throw new Error(
                "City not found. Please try another city."
            );
        }

        const location =
            data.results[0];

        currentLat =
            location.latitude;

        currentLon =
            location.longitude;

        currentCity =
            `${location.name}, ${location.country}`;

        document.getElementById("cityName")
            .textContent = currentCity;

        await loadWeather();

    }catch(error){

        showError(error.message);

    }finally{

        showLoading(false);

    }
}


/* ==========================================
   LOAD WEATHER
========================================== */

async function loadWeather(){

    clearError();

    try{

        showLoading(true);

        const url =
        `https://api.open-meteo.com/v1/forecast?latitude=${currentLat}&longitude=${currentLon}` +
        `&current=temperature_2m,relative_humidity_2m,apparent_temperature,weather_code,cloud_cover,pressure_msl,wind_speed_10m,wind_direction_10m,visibility` +
        `&hourly=precipitation_probability` +
        `&daily=weather_code,temperature_2m_max,temperature_2m_min,sunrise,sunset,precipitation_probability_max` +
        `&timezone=auto&forecast_days=7`;

        const response =
            await fetch(url);

        if(!response.ok){

            throw new Error(
                "Unable to fetch weather data."
            );

        }

        weatherData =
            await response.json();

        displayWeather();

    }catch(error){

        showError(
            "Weather data could not be loaded. Check your internet connection."
        );

        console.error(error);

    }finally{

        showLoading(false);

    }
}


/* ==========================================
   DISPLAY WEATHER
========================================== */

function displayWeather(){

    if(!weatherData) return;

    const current =
        weatherData.current;

    const daily =
        weatherData.daily;

    const info =
        getWeatherInfo(current.weather_code);


    /* Weather condition */

    document.getElementById("weatherIcon")
        .textContent = info[0];

    document.getElementById("condition")
        .textContent = info[1];


    /* Temperature */

    let temp =
        convertTemperature(current.temperature_2m);

    let feels =
        convertTemperature(current.apparent_temperature);

    let min =
        convertTemperature(daily.temperature_2m_min[0]);

    let max =
        convertTemperature(daily.temperature_2m_max[0]);


    document.getElementById("temperature")
        .textContent = Math.round(temp);

    document.getElementById("feelsLike")
        .textContent = Math.round(feels);

    document.getElementById("minTemp")
        .textContent = Math.round(min);

    document.getElementById("maxTemp")
        .textContent = Math.round(max);


    document.getElementById("temperatureUnit")
        .textContent = unit;


    /* Details */

    document.getElementById("humidity")
        .textContent =
        current.relative_humidity_2m + "%";


    document.getElementById("wind")
        .textContent =
        Math.round(current.wind_speed_10m) +
        " km/h";


    document.getElementById("cloud")
        .textContent =
        current.cloud_cover + "%";


    document.getElementById("pressure")
        .textContent =
        Math.round(current.pressure_msl) +
        " hPa";


    document.getElementById("visibility")
        .textContent =
        (current.visibility / 1000).toFixed(1) +
        " km";


    document.getElementById("windDirection")
        .textContent =
        getWindDirection(
            current.wind_direction_10m
        );


    document.getElementById("rain")
        .textContent =
        daily.precipitation_probability_max[0] +
        "%";


    /* Sunrise/Sunset */

    document.getElementById("sunrise")
        .textContent =
        formatTime(daily.sunrise[0]);


    document.getElementById("sunset")
        .textContent =
        formatTime(daily.sunset[0]);


    displayForecast();

    updateDateTime();

}


/* ==========================================
   7 DAY FORECAST
========================================== */

function displayForecast(){

    const forecast =
        document.getElementById("forecast");

    forecast.innerHTML = "";

    const daily =
        weatherData.daily;

    for(let i = 0; i < 7; i++){

        const info =
            getWeatherInfo(
                daily.weather_code[i]
            );

        const min =
            Math.round(
                convertTemperature(
                    daily.temperature_2m_min[i]
                )
            );

        const max =
            Math.round(
                convertTemperature(
                    daily.temperature_2m_max[i]
                )
            );

        const day =
            new Date(
                daily.time[i] + "T12:00:00"
            );

        const dayName =
            i === 0
            ? "Today"
            : day.toLocaleDateString(
                "en-US",
                {weekday:"short"}
            );

        const card =
            document.createElement("div");

        card.className =
            "card forecast-card";

        card.innerHTML = `

            <div class="forecast-day">
                ${dayName}
            </div>

            <div style="font-size:12px;color:var(--muted);margin-top:5px">
                ${formatDate(daily.time[i])}
            </div>

            <div class="forecast-icon">
                ${info[0]}
            </div>

            <div style="font-size:13px">
                ${info[1]}
            </div>

            <div class="forecast-temp">
                ${max}° / ${min}° ${unit}
            </div>

            <div class="forecast-rain">
                💧 ${daily.precipitation_probability_max[i]}%
            </div>
        `;

        forecast.appendChild(card);
    }
}


/* ==========================================
   TEMPERATURE CONVERSION
========================================== */

function convertTemperature(celsius){

    if(unit === "C")
        return celsius;

    return (celsius * 9/5) + 32;
}


/* ==========================================
   CHANGE UNIT
========================================== */

function changeUnit(newUnit){

    unit = newUnit;

    localStorage.setItem(
        "weatherUnit",
        unit
    );

    document
        .getElementById("celsiusBtn")
        .classList.toggle(
            "active",
            unit === "C"
        );

    document
        .getElementById("fahrenheitBtn")
        .classList.toggle(
            "active",
            unit === "F"
        );

    if(weatherData)
        displayWeather();
}


/* ==========================================
   GET MY LOCATION
========================================== */

function getMyLocation(){

    if(!navigator.geolocation){

        showError(
            "Geolocation is not supported by your browser."
        );

        return;
    }

    showLoading(true);

    navigator.geolocation.getCurrentPosition(

        async function(position){

            currentLat =
                position.coords.latitude;

            currentLon =
                position.coords.longitude;

            currentCity =
                "Your Current Location";

            document.getElementById("cityName")
                .textContent =
                currentCity;

            await loadWeather();

            showLoading(false);

        },

        function(){

            showLoading(false);

            showError(
                "Location permission was denied. Please allow location access."
            );

        }

    );
}


/* ==========================================
   FAVORITE CITY
========================================== */

function saveFavorite(){

    if(!currentCity){

        showError(
            "Search for a city first."
        );

        return;
    }

    const favorite = {

        city:currentCity,
        lat:currentLat,
        lon:currentLon

    };

    localStorage.setItem(
        "favoriteWeatherCity",
        JSON.stringify(favorite)
    );

    displayFavorite();

}


/* ==========================================
   DISPLAY FAVORITE
========================================== */

function displayFavorite(){

    const saved =
        localStorage.getItem(
            "favoriteWeatherCity"
        );

    const box =
        document.getElementById(
            "favoriteCity"
        );

    if(!saved){

        box.innerHTML =
            "No favorite city saved";

        return;
    }

    const favorite =
        JSON.parse(saved);

    box.innerHTML = `

        <span>⭐ ${favorite.city}</span>

        <button
            class="small-btn"
            onclick="loadFavorite()">
            Open
        </button>

        <button
            class="small-btn"
            onclick="removeFavorite()">
            Remove
        </button>

    `;
}


/* ==========================================
   LOAD FAVORITE
========================================== */

async function loadFavorite(){

    const saved =
        localStorage.getItem(
            "favoriteWeatherCity"
        );

    if(!saved) return;

    const favorite =
        JSON.parse(saved);

    currentCity =
        favorite.city;

    currentLat =
        favorite.lat;

    currentLon =
        favorite.lon;

    document.getElementById("cityName")
        .textContent =
        currentCity;

    await loadWeather();

}


/* ==========================================
   REMOVE FAVORITE
========================================== */

function removeFavorite(){

    localStorage.removeItem(
        "favoriteWeatherCity"
    );

    displayFavorite();

}


/* ==========================================
   DARK MODE
========================================== */

function toggleTheme(){

    document.body.classList.toggle("dark");

    const isDark =
        document.body.classList.contains("dark");

    localStorage.setItem(
        "weatherTheme",
        isDark ? "dark" : "light"
    );

    document.getElementById("themeBtn")
        .textContent =
        isDark ? "☀️" : "🌙";

}


/* ==========================================
   WIND DIRECTION
========================================== */

function getWindDirection(degrees){

    const directions = [

        "N","NE","E","SE",
        "S","SW","W","NW"

    ];

    const index =
        Math.round(degrees / 45) % 8;

    return directions[index];

}


/* ==========================================
   TIME FORMAT
========================================== */

function formatTime(time){

    const date =
        new Date(time);

    return date.toLocaleTimeString(
        "en-US",
        {
            hour:"2-digit",
            minute:"2-digit"
        }
    );

}


/* ==========================================
   DATE FORMAT
========================================== */

function formatDate(date){

    return new Date(
        date + "T12:00:00"
    ).toLocaleDateString(
        "en-US",
        {
            day:"numeric",
            month:"short"
        }
    );

}


/* ==========================================
   CURRENT DATE & TIME
========================================== */

function updateDateTime(){

    const now =
        new Date();

    document.getElementById("dateTime")
        .textContent =
        now.toLocaleString(
            "en-IN",
            {
                weekday:"long",
                day:"numeric",
                month:"long",
                year:"numeric",
                hour:"2-digit",
                minute:"2-digit"
            }
        );

}


/* ==========================================
   LOADING
========================================== */

function showLoading(show){

    document.getElementById("loading")
        .style.display =
        show ? "block" : "none";

}


/* ==========================================
   ERROR
========================================== */

function showError(message){

    document.getElementById("errorMessage")
        .textContent =
        message;

}


function clearError(){

    document.getElementById("errorMessage")
        .textContent = "";

}


/* ==========================================
   ENTER KEY SEARCH
========================================== */

document.getElementById("cityInput")
    .addEventListener(
        "keypress",
        function(event){

            if(event.key === "Enter"){

                searchCity();

            }

        }
    );


/* ==========================================
   LOAD SAVED THEME
========================================== */

if(
    localStorage.getItem("weatherTheme")
    === "dark"
){

    document.body.classList.add("dark");

    document.getElementById("themeBtn")
        .textContent = "☀️";

}


/* ==========================================
   INITIALIZE
========================================== */

displayFavorite();

changeUnit(unit);

loadWeather();

setInterval(
    updateDateTime,
    60000
);

</script>

</body>
</html>
